meta {
  name: by type Patient Summary (60591-5)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/DocumentReference?patient={{patientId}}&type={{loinc}}|60591-5
  body: none
  auth: inherit
}

headers {
  Accept: application/fhir+json
}

tests {
  test('200 searchset', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().resourceType).to.equal('Bundle');
    expect(res.getBody().type).to.equal('searchset');
  });

  test('returns DocumentReference', function() {
    const e = (res.getBody().entry || []).filter(x => (x.search || {}).mode !== 'include' && (x.search || {}).mode !== 'outcome');
    expect(e.length).to.be.above(0);
    e.forEach(x => expect(x.resource.resourceType).to.equal('DocumentReference'));
  });

  test('every result has type 60591-5', function() {
    res.getBody().entry.forEach(e => expect(e.resource.type.coding.map(c => c.code)).to.include('60591-5'));
  });
}
