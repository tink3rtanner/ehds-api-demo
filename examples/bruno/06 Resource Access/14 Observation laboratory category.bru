meta {
  name: Observation laboratory category
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/Observation?patient={{patientId}}&category=laboratory
  body: none
  auth: inherit
}

headers {
  Accept: application/fhir+json
}

tests {
  test('200 searchset', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().resourceType).to.equal('Bundle');
    expect(res.getBody().type).to.equal('searchset');
  });

  test('returns Observation', function() {
    const e = (res.getBody().entry || []).filter(x => (x.search || {}).mode !== 'include' && (x.search || {}).mode !== 'outcome');
    expect(e.length).to.be.above(0);
    e.forEach(x => expect(x.resource.resourceType).to.equal('Observation'));
  });
}
