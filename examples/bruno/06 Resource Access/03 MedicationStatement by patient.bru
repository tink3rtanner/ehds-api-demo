meta {
  name: MedicationStatement by patient
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/MedicationStatement?patient={{patientId}}
  body: none
  auth: inherit
}

headers {
  Accept: application/fhir+json
}

script:post-response {
  bru.setVar('medicationStatementId', ((res.getBody().entry || [])[0] || {resource: {}}).resource.id || '');
}

tests {
  test('200 searchset', function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().resourceType).to.equal('Bundle');
    expect(res.getBody().type).to.equal('searchset');
  });

  test('returns MedicationStatement', function() {
    const e = (res.getBody().entry || []).filter(x => (x.search || {}).mode !== 'include' && (x.search || {}).mode !== 'outcome');
    expect(e.length).to.be.above(0);
    e.forEach(x => expect(x.resource.resourceType).to.equal('MedicationStatement'));
  });
}
