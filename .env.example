# copy to .env for prod; run.sh sets sane dev defaults already.
EHDS_BASE_URL=https://ehds-demo.example.org
EHDS_ISSUER=https://ehds-demo.example.org
EHDS_DATA_DIR=/var/lib/ehds-api/data
EHDS_CLIENT_REGISTRY=/etc/ehds-api/clients.json
EHDS_JWKS_PATH=/var/lib/ehds-api/keys
EHDS_VALIDATOR_JAR=/var/lib/ehds-api/validator_cli.jar
ENV=prod
PORT=8000
EHDS_RATE_LIMIT_PER_MIN=120
EHDS_BODY_MAX_BYTES=5242880
# asynchronous EU-profile validation of submissions (badge, never gate)
EHDS_EU_PACKAGES_DIR=/srv/ehds-api/.cache/eu-packages
EHDS_VALIDATOR_HOME=/var/lib/ehds-api/data/validator-home
EHDS_VALIDATION_TIMEOUT_SECONDS=1800   # tx.fhir.org can make a first run take 10-20 min
EHDS_VALIDATOR_TX=n/a   # offline (default; known slice-ambiguity artefact is downgraded). Set https://tx.fhir.org for the full verdict
